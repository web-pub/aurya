// Projet : Aurya — Version V01-027
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Documents des membres : profil, postes, projets, réels encodés
    match /auryaUsers/{userId} {
      // Lecture : le membre lui-même, ou l'admin (aperçu global pour le conseil)
      allow get: if request.auth != null && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow list: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));

      // Création : le membre lui-même (onboarding), ou l'admin (création de compte depuis l'espace conseil)
      allow create: if request.auth != null && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));

      // Modification : le membre lui-même à tout moment,
      // ou l'admin si le membre a coché la case d'autorisation,
      // ou l'admin dans tous les cas pour archiver/désarchiver uniquement (gestion de compte,
      // ne touche à aucune donnée financière donc pas besoin du consentement)
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && resource.data.profile.consentementAdmin == true) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']))
      );

      allow delete: if false;
    }

    // Liste des administrateurs (ajoutée manuellement depuis la console Firebase)
    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Discussion membre <-> admin (sous-collection : chaque message est un document,
    // ce qui permet de vérifier que l'expéditeur déclaré est bien la personne connectée —
    // impossible à valider si les messages étaient stockés dans un simple tableau)
    match /chats/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow write: if false; // le document racine n'est jamais écrit directement

      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
        allow create: if request.auth != null
          && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId','text','ts'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Contenu éditable du site public (page d'accueil) — lecture publique,
    // écriture réservée à l'admin depuis l'onglet "Contenu du site"
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Demandes "Devenez membre" (formulaire public sur la page de connexion, non authentifié)
    match /demandes/{demandeId} {
      allow create: if request.resource.data.keys().hasOnly(['nom','prenom','naissance','motivation','email','gsm','statut','creeLe'])
        && request.resource.data.statut == "nouvelle"
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 100
        && request.resource.data.prenom is string && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() <= 100
        && request.resource.data.naissance is string && request.resource.data.naissance.size() <= 20
        && request.resource.data.motivation is string && request.resource.data.motivation.size() <= 1000
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.gsm is string && request.resource.data.gsm.size() > 0 && request.resource.data.gsm.size() <= 50;
      allow read, update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Demandes de réservation / rendez-vous conseil (formulaire public, non authentifié)
    match /reservations/{reservationId} {
      allow create: if request.resource.data.keys().hasOnly(['nom','prenom','email','gsm','dateSouhaitee','message','statut','creeLe'])
        && request.resource.data.statut == "nouvelle"
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 100
        && request.resource.data.prenom is string && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.gsm is string && request.resource.data.gsm.size() > 0 && request.resource.data.gsm.size() <= 50
        && request.resource.data.dateSouhaitee is string && request.resource.data.dateSouhaitee.size() <= 50
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000;
      allow read, update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Messages du formulaire de contact public (page contact.html, non authentifié)
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['nom','prenom','email','message','statut','creeLe'])
        && request.resource.data.statut == "nouveau"
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 100
        && request.resource.data.prenom is string && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 3000;
      allow read, update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Livre d'or (page publique) : n'importe qui peut proposer un message, seules les
    // entrées validées par l'admin sont visibles publiquement ; l'admin voit et gère tout.
    match /livreOr/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['prenom','message','statut','creeLe'])
        && request.resource.data.statut == "nouveau"
        && request.resource.data.prenom is string && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500;
      allow read: if resource.data.statut == "valide" || (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Conseils publiés sur la page publique "Conseils" — gérés un par un depuis l'admin
    // (ajout, modification, publication, masquage), lecture publique seulement si publié.
    match /conseils/{conseilId} {
      allow read: if resource.data.statut == "publie" || (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create, update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
